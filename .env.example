# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# The values shown after the "=" for the *_TERMS / COMPANY_DESCRIPTION /
# SEC_CIK keys are the worked example this tool was originally built
# around (NWBO / Northwest Biotherapeutics' public Telegram investor group).
# Replace them with your own ticker/community — nothing about this tool is
# NWBO-specific except these documented defaults.

# ── Telegram API credentials (required) ───────────────────────────────────────
# Get these at https://my.telegram.org -> API Development Tools.
# This is a *user* account's API credentials (Telethon MTProto), not a bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Target community group (required) ─────────────────────────────────────────
# Numeric chat/channel ID. Run `python telegram_scanner.py --auth` once to
# print your joined dialogs and their IDs, or set an invite hash below to
# join automatically.
TELEGRAM_GROUP_ID=
TELEGRAM_INVITE_HASH=

# ── Bot used to push alerts/reports (optional but recommended) ───────────────
# Create a bot via @BotFather, then get your chat_id by messaging the bot and
# hitting https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gemini — used only for rationale/summary text, never signal generation ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Ticker / company under coverage ───────────────────────────────────────────
TICKER=NWBO
SEC_CIK=0000849399
COMPANY_DESCRIPTION=Northwest Biotherapeutics (NWBO), a clinical-stage glioblastoma immunotherapy company (DCVax-L product)

# ── Approval-probability model base rate ──────────────────────────────────────
# Coarse prior for your ticker's regulatory pathway/indication, adjusted by
# community sentiment (+/-25%). This is not a calibrated statistical model.
BASE_APPROVAL_PROB=0.48

# ── Optional community/ticker-specific lexicon additions (comma-separated) ───
# Base lexicon in each script is generic FDA/trading language; put your
# community's own jargon here instead of editing the scripts. These are the
# terms NWBO's community actually used, kept as a worked example.
EXTRA_BULLISH_TERMS=dcvax,glioblastoma,gbm approval,os benefit
EXTRA_BEARISH_TERMS=
EXTRA_CATALYST_TERMS=dcvax,glioblastoma,gbm,brain tumor
EXTRA_ANALYTICAL_KEYWORDS=dcvax,glioblastoma,gbm,brain tumor,immunotherapy

# ── Alert / backtest thresholds ───────────────────────────────────────────────
ALERT_THRESHOLD=62.0
BACKTEST_BUY_THRESHOLD=62.0
BACKTEST_SELL_THRESHOLD=57.0
BACKTEST_START_DATE=2018-01-01

# ── Local data directory (sessions, corpus, analysis, state, logs) ───────────
# Defaults to ./data if unset.
SCANNER_DATA_DIR=
